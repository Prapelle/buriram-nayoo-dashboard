# คัดลอกเป็น .env.local (ใช้ตอน dev) และ .dev.vars (ใช้ตอน npm run preview) — ห้าม commit
# ห้ามใช้ prefix NEXT_PUBLIC_ กับค่าเหล่านี้

AUTH_SECRET=                 # สร้างด้วย: openssl rand -base64 32
AUTH_GOOGLE_ID=              # OAuth Client ID
AUTH_GOOGLE_SECRET=          # OAuth Client Secret
INITIAL_ADMIN_EMAIL=         # อีเมล Google ของ Admin คนแรก

GOOGLE_SHEET_ID=             # ID ในลิงก์ Spreadsheet (ส่วนระหว่าง /d/ และ /edit)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# ใส่ private_key จาก JSON ทั้งก้อนในเครื่องหมายคำพูด โดยคง \n ไว้ตามเดิม
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

GOOGLE_DRIVE_FOLDER_ID=      # (ไม่บังคับ) เก็บไฟล์ CSV ต้นฉบับ
